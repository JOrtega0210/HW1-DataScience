# ============================================================
# Configuración del bot RPA - PeopleSync (Registro de Ingresos)
# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas tu ".env" real con datos sensibles al repositorio.
# ============================================================

# URL del formulario web a automatizar
FORM_URL=https://the-paul2002.github.io/Proyecto-IA-/Homework1/

# Ruta al archivo Excel con el dataset de empleados a registrar
EXCEL_PATH=./Ingreso_Personal_Agosto.xlsx

# Nombre de la hoja de Excel a leer (vacío = primera hoja)
EXCEL_SHEET_NAME=

# Modo headless del navegador: true/false
# true  = Chrome corre sin ventana visible (recomendado para Task Scheduler)
# false = Chrome corre con ventana visible (recomendado para depurar)
HEADLESS=false

# Timeout (segundos) para esperas explícitas (WebDriverWait)
EXPLICIT_WAIT_SECONDS=15

# Timeout (segundos) para espera implícita del driver
IMPLICIT_WAIT_SECONDS=2

# Ruta a un chromedriver.exe local. Déjalo vacío para que el bot use el
# Selenium Manager incorporado (Selenium >= 4.6), que descarga y resuelve
# automáticamente la versión de chromedriver compatible con el Chrome
# instalado. Solo necesitas esta variable si no hay acceso a internet.
CHROMEDRIVER_PATH=

# Carpeta donde se guardan los logs de ejecución
LOG_DIR=./logs

# Carpeta donde se guardan capturas de pantalla en caso de error
SCREENSHOT_DIR=./screenshots

# Carpeta donde se guarda el reporte .xlsx de resultados de cada corrida
# (Resumen + Detalle por DNI). Ver sección "Contenido extra" del README.
REPORT_DIR=./reports

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Archivo de estado usado para el modo "resume" (evita re-registrar
# DNIs ya procesados exitosamente en una corrida anterior)
STATE_FILE=./state/registrados.json

# Habilita el modo resume por defecto: true/false
# (también se puede forzar con --resume / --no-resume por línea de comandos)
# NOTA: el formulario es 100% client-side y no persiste nada entre sesiones
# de navegador (cada ejecución empieza con la tabla y el contador en cero).
# Por eso el default es "false": cada corrida debe intentar los 50 registros
# de nuevo. Actívalo solo si vas a reanudar una MISMA corrida interrumpida
# sin cerrar el navegador (ver README).
RESUME=false

# Límite máximo de registros a procesar en una corrida (vacío = todos)
MAX_RECORDS=

# Qué hacer cuando el valor de "genero" del Excel no coincide con las
# opciones del formulario (el select solo acepta "Masculino"/"Femenino"):
#   skip     -> omite el registro y lo reporta como omitido (recomendado)
#   default  -> fuerza siempre GENERO_DEFAULT_VALUE
#   alternate-> alterna Masculino/Femenino para los valores no soportados
GENERO_UNSUPPORTED_ACTION=skip

# Valor usado solo si GENERO_UNSUPPORTED_ACTION=default
GENERO_DEFAULT_VALUE=Masculino
